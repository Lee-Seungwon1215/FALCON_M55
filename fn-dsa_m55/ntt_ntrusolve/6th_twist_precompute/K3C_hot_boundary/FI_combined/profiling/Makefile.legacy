# Historical C-only profiling setup. NOT the H1 MVE benchmark entry point.
# Retained for reference; use the current Makefile / README.md instead.
ARM_GCC_ROOT ?= /private/tmp/arm-gnu-toolchain-15.3.rel1-expanded/Payload
STM32CUBE_N6 ?= /private/tmp/STM32CubeN6
STM32L4_SYSTEM ?= /Users/seungwon/.platformio/packages/framework-arduinoststm32/system
CMSIS_CORE ?= /Users/seungwon/.platformio/packages/framework-cmsis/CMSIS/Core/Include
TARGET ?= host
INSTRUMENT ?= 1
BUILD = build/$(TARGET)-$(INSTRUMENT)
GEN = $(BUILD)/generated
ELF = $(BUILD)/fndsa512_profile.elf
PREFIX = $(ARM_GCC_ROOT)/bin/arm-none-eabi-
SOURCES = codec mq sha3 sysrng util kgen kgen_fxp kgen_gauss kgen_mp31 kgen_ntru kgen_poly kgen_zint31 sign sign_core sign_fpoly sign_fpr sign_sampler vrfy
UPSTREAM = $(addprefix ../,$(addsuffix .c,$(SOURCES)))
GENERATED = $(addprefix $(GEN)/,$(addsuffix .c,$(SOURCES)))
DEFINES = -DFNDSA_PROFILE=$(INSTRUMENT) -DFNDSA_ASM_CORTEXM4=0 \
 -DFNDSA_AVX2=0 -DFNDSA_SSE2=0 -DFNDSA_NEON=0 -DFNDSA_NEON_SHA3=0 \
 -DFNDSA_RV64D=0 -DFNDSA_64=0 -DFNDSA_RNG_GETENTROPY=0 \
 -DFNDSA_RNG_URANDOM=0 -DFNDSA_RNG_WIN32=0
CFLAGS = -std=c99 -O3 -g3 -ffunction-sections -fdata-sections \
 -fno-strict-aliasing -ffp-contract=off -Wall -Wextra -Wno-unused-parameter -Wno-unused-function \
 $(DEFINES) -I. -I.. $(EXTRA_CFLAGS)
LOCAL = bench.c profile.c

ifeq ($(TARGET),host)
CC = clang
CFLAGS += -fno-vectorize -fno-slp-vectorize
LDLIBS = -lm
else
CC = $(PREFIX)gcc
CFLAGS += -fno-tree-vectorize -DFNDSA_PROFILE_CORTEX_M
LDFLAGS = $(ARCH) -T$(LINKER) --specs=nano.specs --specs=nosys.specs \
 -Wl,--gc-sections -Wl,-Map=$(BUILD)/fndsa512_profile.map -Wl,--print-memory-usage
LDLIBS = -Wl,--start-group -lc -lm -lgcc -Wl,--end-group
endif

ifeq ($(TARGET),m55)
ARCH = -mcpu=cortex-m55 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard -mcmse
FALCON_PLATFORM = ../../falcon_ref/profiling/stm32n657
HAL = $(STM32CUBE_N6)/Drivers/STM32N6xx_HAL_Driver
CMSIS = $(STM32CUBE_N6)/Drivers/CMSIS
DEVICE = $(CMSIS)/Device/ST/STM32N6xx
TEMPLATE = $(STM32CUBE_N6)/Projects/NUCLEO-N657X0-Q/Templates/Template/FSBL
LINKER = $(FALCON_PLATFORM)/stm32n657_axisram2_fsbl.ld
LOCAL += platform_m55.c $(FALCON_PLATFORM)/platform_nucleo_n657x0_q.c
PLATFORM = $(TEMPLATE)/Src/stm32n6xx_hal_msp.c $(TEMPLATE)/Src/stm32n6xx_it.c \
 $(TEMPLATE)/Src/system_stm32n6xx_fsbl.c \
 $(DEVICE)/Source/Templates/gcc/startup_stm32n657xx_fsbl.s \
 $(addprefix $(HAL)/Src/stm32n6xx_hal,$(addsuffix .c, _cortex _dma _dma_ex _exti _gpio _pwr _pwr_ex _rcc _rcc_ex)) \
 $(HAL)/Src/stm32n6xx_hal.c
CFLAGS += $(ARCH) -DUSE_HAL_DRIVER -DSTM32N657xx -DFNDSA_PROFILE_DWT_UNLOCK \
 -Dfalcon_bench_state=fndsa_bench_state \
 -I$(TEMPLATE)/Inc -I$(STM32CUBE_N6)/Drivers/BSP/STM32N6xx_Nucleo \
 -I$(HAL)/Inc -I$(HAL)/Inc/Legacy -I$(DEVICE)/Include -I$(CMSIS)/Include
endif

ifeq ($(TARGET),m4)
ARCH = -mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard
HAL = $(STM32L4_SYSTEM)/Drivers/STM32L4xx_HAL_Driver
CMSIS = $(STM32L4_SYSTEM)/Drivers/CMSIS
DEVICE = $(CMSIS)/Device/ST/STM32L4xx
LINKER = stm32l4rs_sram.ld
LOCAL += platform_m4.c
PLATFORM = $(DEVICE)/Source/Templates/system_stm32l4xx.c \
 $(DEVICE)/Source/Templates/gcc/startup_stm32l4r5xx.s \
 $(addprefix $(HAL)/Src/stm32l4xx_hal,$(addsuffix .c, _cortex _rcc _rcc_ex _pwr _pwr_ex)) \
 $(HAL)/Src/stm32l4xx_hal.c
CFLAGS += $(ARCH) -DUSE_HAL_DRIVER -DSTM32L4R5xx -DUSER_VECT_TAB_ADDRESS \
 -DVECT_TAB_SRAM -I$(HAL)/Inc -I$(HAL)/Inc/Legacy -I$(DEVICE)/Include -I$(CMSIS_CORE)
endif

.PHONY: all run
all: $(ELF)
$(GEN)/.stamp: instrument.py $(UPSTREAM)
	python3 instrument.py $(GEN)
$(ELF): $(GEN)/.stamp $(LOCAL) profile.h stm32l4xx_hal_conf.h Makefile $(LINKER) $(wildcard ../*.h)
	$(CC) $(CFLAGS) $(GENERATED) $(LOCAL) $(PLATFORM) $(LDFLAGS) $(LDLIBS) -o $@
ifneq ($(TARGET),host)
	$(PREFIX)size $@
endif
run: $(ELF)
	$(ELF)

.PHONY: test
test: $(GEN)/.stamp
	$(CC) $(CFLAGS) -UFNDSA_RNG_URANDOM -DFNDSA_RNG_URANDOM=1 $(GENERATED) ../test_fndsa.c profile.c $(LDLIBS) -o $(BUILD)/test_fndsa
	$(BUILD)/test_fndsa
