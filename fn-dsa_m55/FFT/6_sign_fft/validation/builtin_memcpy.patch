+/* M55 signing FFT only: fpr already contains an IEEE-754 binary64 bit
+ * pattern, not a numeric uint64_t or a Q32 value. Built-in memcpy preserves that
+ * pattern without an aliasing violation or a numeric conversion. These
+ * helpers are private: LDL, split/merge and the sampler retain their
+ * original arithmetic. The explicit built-in also avoids out-of-line libc
+ * calls in freestanding firmware. Compile with FP contraction and fast-math
+ * disabled.
+ */
+_Static_assert(sizeof(double) == sizeof(fpr), "binary64 double required");
+
+static inline double
+fft_load_f64(const fpr *src)
+{
+	double x;
+	__builtin_memcpy(&x, src, sizeof x);
+	return x;
+}
+
+static inline void
+fft_store_f64(fpr *dst, double x)
+{
+	__builtin_memcpy(dst, &x, sizeof x);
+}
